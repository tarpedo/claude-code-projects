#!/usr/bin/env bash
# shellcheck disable=SC2016  # awk programs are single-quoted on purpose
# ccpr — Claude Code Projects: crash-proof Claude Code sessions in tmux.
#
# Model: a project is a tmux session, a task is a window, and every window is
# bound to one Claude Code session id in a manifest (project, window, dir, id).
# `ccpr claude` resumes the bound session or starts a new one with a
# pre-generated id, so after tmux dies `ccpr restore` can bring every window
# and its conversation back.
#
# Usage:
#   ccpr                    project menu (bound to F1)
#   ccpr claude [ARGS…]     run claude bound to the current window
#   ccpr restore            recreate all windows from the manifest
#   ccpr forget             close a window and drop it from the manifest
#   ccpr rename WID NAME    rename a window together with its manifest row (F5)
#   ccpr add [NAME] [DIR]   register a project
#   ccpr remove [NAME]      unregister a project (never touches the directory)
#   ccpr help               cheat sheet (F7)
#
# Internal, called by tmux, Claude Code hooks and the shell:
#   ccpr bind               SessionStart hook: bind the session that just started
#   ccpr status STATE       agent state glyph: work ◐ | ask ! | done ✓ | clear
#   ccpr waiting [WID]      status-line segment listing windows waiting for you
#   ccpr drop PANE          forget the window of PANE (bash EXIT trap)

set -o pipefail

readonly VERSION=1.0.0
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ccpr"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ccpr"
PROJECTS="${CCPR_PROJECTS:-$CONFIG_DIR/projects.tsv}"
MANIFEST="${CCPR_MANIFEST:-$STATE_DIR/sessions.tsv}"
SELF=$(readlink -f "${BASH_SOURCE[0]}")
TAB_CMD="'$SELF' claude; exec \"\${SHELL:-bash}\""   # what a new window runs

mkdir -p "${PROJECTS%/*}" "${MANIFEST%/*}"
touch "$PROJECTS" "$MANIFEST"

# ── helpers ──────────────────────────────────────────────────────────────────

die()  { printf '  ✗ %s\n' "$*" >&2; exit 1; }
say()  { printf '  %s\n' "$*"; }

tmx() {                          # tmx TARGET FORMAT → value of a tmux format
    tmux display-message -p -t "$1" "$2" 2>/dev/null
}

has_session() { tmux has-session -t "=$1" 2>/dev/null; }

has_window() {                   # has_window PROJECT WINDOW
    has_session "$1" && tmux list-windows -t "=$1" -F '#W' | grep -qxF -- "$2"
}

load_projects() {                # fills names[] and dirs[]
    names=() dirs=()
    local name dir
    while IFS=$'\t' read -r name dir; do
        [[ -n $name ]] && names+=("$name") dirs+=("$dir")
    done < "$PROJECTS"
}

project_dir() {                  # project_dir NAME → directory or nothing
    local i
    for i in "${!names[@]}"; do
        [[ ${names[i]} == "$1" ]] && { printf '%s\n' "${dirs[i]}"; return; }
    done
}

session_id() {                   # session_id PROJECT WINDOW → bound id
    awk -F'\t' -v p="$1" -v w="$2" '$1==p && $2==w {print $4; exit}' "$MANIFEST"
}

rewrite() {                      # rewrite FILE AWK_ARGS… — atomic in-place awk
    local file=$1 tmp
    shift
    tmp=$(mktemp "$file.XXXXXX") || return
    if awk -F'\t' -v OFS='\t' "$@" "$file" > "$tmp"; then
        mv -f "$tmp" "$file"
    else
        rm -f "$tmp"; return 1
    fi
}

bind_row() {                     # bind_row PROJECT WINDOW DIR ID — upsert a row
    rewrite "$MANIFEST" -v p="$1" -v w="$2" -v d="$3" -v id="$4" \
        '!($1==p && $2==w) {print} END {print p, w, d, id}'
}

drop_row() {                     # drop_row PROJECT WINDOW
    rewrite "$MANIFEST" -v p="$1" -v w="$2" '!($1==p && $2==w)'
}

transcript_exists() {            # Claude Code keeps transcripts as <id>.jsonl
    compgen -G "$HOME/.claude/projects/*/$1.jsonl" >/dev/null
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_claude() {
    [[ -n $TMUX ]] || exec claude "$@"

    local project window id
    project=$(tmx "$TMUX_PANE" '#S')
    window=$(tmx "$TMUX_PANE" '#W')
    if [[ -z $window ]]; then
        read -rp "  Window name: " window
        [[ -n $window ]] || die "refusing to start claude in an unnamed window"
        tmux rename-window -t "$TMUX_PANE" "$window"
    fi

    id=$(session_id "$project" "$window")
    if [[ -n $id ]] && transcript_exists "$id"; then
        exec claude --resume "$id" "$@"
    fi

    # no binding yet, or the transcript was cleaned up: start a fresh session
    id=$(uuidgen)
    bind_row "$project" "$window" "$PWD" "$id"
    exec claude --session-id "$id" "$@"
}

cmd_bind() {
    [[ -n $TMUX_PANE ]] || return 0
    local sid pid claude_pid pane_pid project window dir
    sid=$(grep -oE '"session_id" *: *"[0-9a-f-]{36}"' | grep -oE '[0-9a-f-]{36}')
    [[ -n $sid ]] || return 0

    # the nearest claude ancestor is the session that fired the hook
    pid=$$
    while pid=$(ps -o ppid= -p "$pid" | tr -d ' ') && (( ${pid:-1} > 1 )); do
        [[ $(ps -o comm= -p "$pid") == claude ]] && { claude_pid=$pid; break; }
    done
    [[ -n $claude_pid ]] || return 0

    # bind only the window's main claude, not `claude -p` run from scripts
    pane_pid=$(tmx "$TMUX_PANE" '#{pane_pid}')
    [[ $claude_pid == "$pane_pid" ||
       $(ps -o ppid= -p "$claude_pid" | tr -d ' ') == "$pane_pid" ]] || return 0
    tr '\0' ' ' < "/proc/$claude_pid/cmdline" |
        grep -qE ' (-p|--print)( |$)' && return 0

    project=$(tmx "$TMUX_PANE" '#S')
    window=$(tmx "$TMUX_PANE" '#W')
    [[ -n $window ]] || return 0
    [[ $(session_id "$project" "$window") == "$sid" ]] && return 0

    dir=$(readlink "/proc/$claude_pid/cwd") || dir=$PWD
    bind_row "$project" "$window" "$dir" "$sid"
}

cmd_status() {
    [[ -n $TMUX_PANE ]] || return 0
    local glyph
    case $1 in
        work) glyph='◐' ;;
        ask)  glyph='!' ;;
        done) glyph='✓' ;;
        *)    glyph='' ;;
    esac
    if [[ -n $glyph ]]; then
        tmux set-option -w -t "$TMUX_PANE" @agent "$glyph"
    else
        tmux set-option -wu -t "$TMUX_PANE" @agent
    fi 2>/dev/null
    return 0
}

cmd_waiting() {                  # every window whose agent waits, except WID
    local list
    list=$(tmux list-windows -a -F $'#{window_id}\t#{@agent}\t#S/#W' 2>/dev/null |
        awk -F'\t' -v cur="$1" '$2=="!" && $1!=cur {print $3}' | paste -sd' ')
    [[ -n $list ]] && printf '#[fg=colour196,bold]! waiting: %s #[default] ' "$list"
    return 0
}

cmd_rename() {
    local wid=$1 new=$2 project old
    [[ -n $wid && -n $new ]] || return 0
    project=$(tmx "$wid" '#S')
    old=$(tmx "$wid" '#W')
    [[ $old == "$new" ]] && return 0
    if [[ -n $(session_id "$project" "$new") ]]; then
        tmux display-message "$project already has a window named '$new'"
        return 1
    fi
    tmux rename-window -t "$wid" "$new"
    rewrite "$MANIFEST" -v p="$project" -v o="$old" -v n="$new" \
        '$1==p && $2==o {$2=n} 1'
}

cmd_drop() {
    local project window
    project=$(tmx "$1" '#S')
    window=$(tmx "$1" '#W')
    [[ -n $project && -n $window ]] && drop_row "$project" "$window"
    return 0
}

cmd_add() {
    local name=$1 dir=$2
    [[ -n $name ]] || read -rp "  Project name: " name
    [[ -n $name ]] || return 0
    [[ $name =~ ^[A-Za-z0-9_-]+$ ]] ||
        die "project name must match [A-Za-z0-9_-]+ (it becomes a tmux session name)"
    [[ -z $(project_dir "$name") ]] || die "project $name already exists: $(project_dir "$name")"
    [[ -n $dir ]] || read -rp "  Directory [$PWD]: " dir
    dir=${dir:-$PWD}
    dir=${dir/#\~/$HOME}
    [[ -d $dir ]] || die "no such directory: $dir"
    dir=$(cd "$dir" && pwd)
    printf '%s\t%s\n' "$name" "$dir" >> "$PROJECTS"
    say "✓ added $name → $dir"
}

cmd_remove() {
    local name=$1 i n answer saved
    if [[ -z $name ]]; then
        echo
        for i in "${!names[@]}"; do
            printf '  %2d) %-12s %s\n' $((i + 1)) "${names[i]}" "${dirs[i]}"
        done
        echo
        read -rp "  Remove project # (empty: cancel): " n
        [[ $n =~ ^[0-9]+$ && -n ${names[n - 1]} ]] || return 0
        name=${names[n - 1]}
    fi
    [[ -n $(project_dir "$name") ]] || die "no such project: $name"

    rewrite "$PROJECTS" -v p="$name" '$1!=p'
    say "✓ removed $name from the list (directory untouched)"

    saved=$(awk -F'\t' -v p="$name" '$1==p' "$MANIFEST" | wc -l)
    if (( saved > 0 )); then
        read -rp "  Also forget its $saved saved session(s)? [y/N] " answer
        if [[ $answer == [yY]* ]]; then
            rewrite "$MANIFEST" -v p="$name" '$1!=p'
            say "✓ sessions forgotten (transcripts are kept by Claude Code)"
        else
            say "sessions kept — restore will still bring them back"
        fi
    fi
    has_session "$name" && say "tmux session $name is still running — left as is"
    return 0
}

cmd_restore() {
    local project window dir id created=0 skipped=0 failed=0
    [[ -s $MANIFEST ]] || { say "manifest is empty: $MANIFEST"; return 0; }

    # restore may be started twice at once (menu and tmux.conf): serialize
    exec 9>>"$MANIFEST.lock"
    flock -w 60 9 || die "another restore is still running"

    while IFS=$'\t' read -r project window dir id; do
        [[ -n $project ]] || continue
        [[ -n $window ]] || { say "✗ $project: row without a window name (use forget)"; continue; }
        [[ -d $dir ]] || dir=$(project_dir "$project")
        [[ -d $dir ]] || { say "✗ $project/$window: directory is gone"; continue; }

        if has_window "$project" "$window"; then
            skipped=$((skipped + 1)); continue
        elif has_session "$project"; then
            tmux new-window -d -t "=$project:" -n "$window" -c "$dir" "$TAB_CMD" 9>&-
        else
            # 9>&-: a tmux server started here must not inherit the lock
            tmux new-session -d -s "$project" -n "$window" -c "$dir" "$TAB_CMD" 9>&-
        fi || { say "✗ $project/$window: tmux refused to create the window"; failed=$((failed + 1)); continue; }
        created=$((created + 1))
        say "● $project/$window  ${id:0:8}"
    done < "$MANIFEST"

    echo
    say "restored: $created, already running: $skipped$( ((failed)) && echo ", failed: $failed")"
    exec 9>&-
    (( failed == 0 ))
}

cmd_forget() {
    local -a rows
    local n i project window dir id
    mapfile -t rows < "$MANIFEST"
    (( ${#rows[@]} )) || { say "manifest is empty"; return 0; }
    echo
    for i in "${!rows[@]}"; do
        IFS=$'\t' read -r project window dir id <<< "${rows[i]}"
        printf '  %2d) %-12s %-16s %s\n' $((i + 1)) "$project" "${window:-(unnamed)}" "${id:0:8}"
    done
    echo
    read -rp "  Forget # — close the window and drop it (empty: cancel): " n
    [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 )) && [[ -n ${rows[n - 1]} ]] || return 0

    IFS=$'\t' read -r project window dir id <<< "${rows[n - 1]}"
    rewrite "$MANIFEST" -v n="$n" 'NR!=n'
    say "dropped from the manifest"
    if [[ -n $window ]] && has_window "$project" "$window"; then
        tmux kill-window -t "=$project:=$window" && say "closed $project/$window"
    fi
}

cmd_help() {
    cat <<'TXT'
  CHEAT SHEET

  Open a project        F1 (or `ccpr`) → number; a new project starts with claude
  New task              F2 → task name: claude starts and the window remembers it
  Back to a task        F2 → the same name (resumes), or `ccpr claude` in its shell
  Plain shell window    F8 → name
  Prev / next window    F3 / F4          Detach    F6
  Rename window         F5 — the session stays bound to it

  tmux crashed          do nothing: windows and sessions come back on start
                        (manually: F1 → r)
  Done with a task      leave claude (/exit), then `exit` the shell: the window
                        closes and is forgotten. Without `exit` it stays restorable.
  Forget from outside   F1 → f

  Add project           F1 → a   (or: ccpr add NAME DIR)
  Remove project        F1 → d   (or: ccpr remove NAME) — directory untouched

  Agent state           next to the window name and in the menu:
                        ◐ working   ! waiting for you   ✓ answered
  Waiting elsewhere     status line: "! waiting: project/window …"
TXT
    printf '\n  Projects: %s\n  Manifest: %s\n' "$PROJECTS" "$MANIFEST"
}

cmd_menu() {
    local open i name windows saved choice
    if ! tmux list-sessions >/dev/null 2>&1 && [[ -s $MANIFEST ]]; then
        echo
        say "tmux is not running — restoring saved sessions:"
        cmd_restore
    fi

    open=$(tmux list-sessions -F '#S' 2>/dev/null)
    echo
    for i in "${!names[@]}"; do
        name=${names[i]}
        if grep -qxF -- "$name" <<< "$open"; then
            windows=$(tmux list-windows -t "=$name" -F '#W#{@agent}' | paste -sd' ')
            printf '  %2d) %-12s ● %s\n' $((i + 1)) "$name" "$windows"
        else
            saved=$(awk -F'\t' -v p="$name" '$1==p {print $2}' "$MANIFEST" | paste -sd' ')
            printf '  %2d) %-12s %s\n' $((i + 1)) "$name" "${saved:+○ $saved}"
        fi
    done
    cat <<'TXT'

  ● running (windows)   ○ saved, not running   ◐ working  ! waiting  ✓ answered
   r) restore all    f) forget a window    a) add project    d) remove project    h) help

TXT
    read -rp "  Project #: " choice
    case $choice in
        r) cmd_restore; pause; exec "$SELF" ;;
        f) cmd_forget;         exec "$SELF" ;;
        a) cmd_add;     pause; exec "$SELF" ;;
        d) cmd_remove;  pause; exec "$SELF" ;;
        h) cmd_help;    pause; exec "$SELF" ;;
    esac

    [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 )) || return 0
    name=${names[choice - 1]}
    [[ -n $name ]] || return 0

    if ! has_session "$name"; then
        read -rp "  First window name [main]: " window
        tmux new-session -d -s "$name" -n "${window:-main}" -c "${dirs[choice - 1]}" "$TAB_CMD"
    fi
    if [[ -n $TMUX ]]; then
        tmux switch-client -t "=$name"
    else
        tmux attach-session -t "=$name"
    fi
}

pause() { read -rp "  Enter → back"; }

# ── dispatch ─────────────────────────────────────────────────────────────────

load_projects
case $1 in
    claude)          shift; cmd_claude "$@" ;;
    bind)            cmd_bind ;;
    status)          cmd_status "$2" ;;
    waiting)         cmd_waiting "$2" ;;
    rename)          cmd_rename "$2" "$3" ;;
    drop)            cmd_drop "$2" ;;
    restore)         cmd_restore ;;
    forget)          cmd_forget ;;
    add)             shift; cmd_add "$@" ;;
    remove)          shift; cmd_remove "$@" ;;
    help|-h|--help)  cmd_help; [[ -t 0 && -n $TMUX ]] && pause; true ;;
    version|--version) echo "ccpr $VERSION" ;;
    "")              cmd_menu ;;
    *)               die "unknown command: $1 (see: ccpr help)" ;;
esac
